<?xml version="1.0" encoding="utf-8"?>
<!-- About dialog contents (version, credits, license, project link).
     Mirrors the Windows sender's About window. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAN Media Receiver"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAboutVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Version 1.0"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Windows to Android, LAN-based, screen &amp; audio streaming"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Design Guidance and Testing by Mike Young\nProgrammed by Anthropic Claude Opus 4.8 High"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="License"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Released under the MIT License. This app also uses open-source components (AndroidX and Material Components) under their own licenses. See the repository for full license texts and third-party notices."
            android:textColor="@color/text"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Project"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAboutLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="https://github.com/myoung8223/LAN-Media-Streaming"
            android:textColor="@color/accent"
            android:textColorLink="@color/accent"
            android:autoLink="web"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAboutClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:text="Close"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
